# Source tarballs are described, never committed (see uploads/*/manifest.json)
*.tar.bz2
*.tar.gz
*.tgz
*.zip
# build scratch
/.build/
__pycache__/
node_modules/
# Uploaded documents whose licence does not allow redistribution stay local (see uploads/*/manifest.json)
*.pdf
*.doc
*.docx
# the built site (src/tools/build_site.py; published by .github/workflows/pages.yml)
/_site/
# Uploaded documents: only each manifest is tracked (bean ihris-hbuc)
/uploads/ihris-admin-handbook/*
!/uploads/ihris-admin-handbook/manifest.json
/uploads/ihris-use-cases/*
!/uploads/ihris-use-cases/manifest.json

# Sub-instances' declared git sources, mounted at <name>-source/ by src/tools/mount_sources.py: another
# repository's bytes at a pin, never committed (the iHRIS 5 source: src/ihris5/ihris5.json `source`).
/*-source/

# BEGIN index mounts (generated from index.config.json — do not edit)
/folio-assistant-core/
/cat-harness/
/cat-harness-tools/
/bootstrap/
/bootstrap-tools/
/fhir-harness/
# END index mounts
# SUSHI's build output (src/tools/gen_fsh.py); the FSH is committed, the build is not
src/ihris-4-on-fhir/fsh-generated/
