	"csd_facility" [style=filled fillcolor = lightpink   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>csd_facility (CSD_Facility) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>entityID (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Entity ID *</font></td></tr><tr><td ALIGN='LEFT'>source_directory (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Source Directory *</font></td></tr><tr><td ALIGN='LEFT'>primary_name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *</font></td></tr><tr><td ALIGN='LEFT'>csd_facility_type (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Facility Type *</font></td></tr><tr><td ALIGN='LEFT'>longitude (FLOAT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Longitude</font></td></tr><tr><td ALIGN='LEFT'>altitude (FLOAT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Altitude</font></td></tr><tr><td ALIGN='LEFT'>latitude (FLOAT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Latitude</font></td></tr><tr><td ALIGN='LEFT'>geo_coordinate_system (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Geo-Coordinate System</font></td></tr></table>> shape = "Mrecord"   ];
