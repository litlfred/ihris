digraph g {
	graph [
		fontsize=50
		labelloc=t
		overlap=false
		rankdir=LR
		splines=true
		label="iHRIS Manage - 4.3.3"
	];
	ratio = auto;
	"splitter+access_facility+location" [shape=point size = 1 label = ""  ] ;
	"splitter+facility+location" [shape=point size = 1 label = ""  ] ;
	"splitter+person+residence" [shape=point size = 1 label = ""  ] ;
	"splitter+scheduled_training_course+location" [shape=point size = 1 label = ""  ] ;
	"splitter+training_funder+location" [shape=point size = 1 label = ""  ] ;
	"splitter+training_institution+location" [shape=point size = 1 label = ""  ] ;
	"access_department" [style=filled fillcolor = moccasin   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>access_department (iHRIS_UserAccessDepartment) </td></tr><tr><td ALIGN='LEFT'>department (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Department !∈ {parent}</font></td></tr></table>> shape = "Mrecord"   ];
	"access_facility" [style=filled fillcolor = lightpink   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>access_facility (iHRIS_UserAccessFacility) </td></tr><tr><td ALIGN='LEFT'>location (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Facility or Geographic Location !∈ {parent}</font></td></tr></table>> shape = "Mrecord"   ];
	"accident" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>accident (iHRIS_Accident) </td></tr><tr><td ALIGN='LEFT'>occurence_date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Date of Occurence</font></td></tr><tr><td ALIGN='LEFT'>accident_type (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Accident Type *</font></td></tr><tr><td ALIGN='LEFT'>start_date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Start of Applicability *</font></td></tr><tr><td ALIGN='LEFT'>end_date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>End of Applicability</font></td></tr><tr><td ALIGN='LEFT'>followup (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Follow-up Required</font></td></tr><tr><td ALIGN='LEFT'>persons_involved (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>People Involved</font></td></tr></table>> shape = "Mrecord"   ];
	"application" [style=filled fillcolor = mistyrose   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>application (iHRIS_Applicant) </td></tr><tr><td ALIGN='LEFT'>position (MAP_MULT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Position(s) *</font></td></tr><tr><td ALIGN='LEFT'>felony (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Have you ever been convicted of a felony?</font></td></tr><tr><td ALIGN='LEFT'>felony_circumstance (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>If yes, give the circumstances.</font></td></tr><tr><td ALIGN='LEFT'>other_info (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>In addition to your work history, are there other skills, qualifications or experience we should consider?</font></td></tr><tr><td ALIGN='LEFT'>hear (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>How did you hear of this opening?</font></td></tr><tr><td ALIGN='LEFT'>start_date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>When can you start?</font></td></tr><tr><td ALIGN='LEFT'>desired_wage (CURRENCY)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Desired Wage</font></td></tr><tr><td ALIGN='LEFT'>full_time (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Are you looking for full-time employment?</font></td></tr><tr><td ALIGN='LEFT'>hours (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>If no, what hours are you available?</font></td></tr></table>> shape = "Mrecord"   ];
	"archived_report" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>archived_report (I2CE_ArchivedReport) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>report (DOCUMENT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Report</font></td></tr><tr><td ALIGN='LEFT'>date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Generation Date *</font></td></tr><tr><td ALIGN='LEFT'>report_view (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Report View !∈ {date}</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Title *</font></td></tr></table>> shape = "Mrecord"   ];
	"benefit" [style=filled fillcolor = lemonchiffon   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>benefit (iHRIS_Benefit) </td></tr><tr><td ALIGN='LEFT'>type (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Benefit Type *</font></td></tr><tr><td ALIGN='LEFT'>amount (CURRENCY)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Amount *</font></td></tr><tr><td ALIGN='LEFT'>source (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Source *</font></td></tr><tr><td ALIGN='LEFT'>start_date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Start Date *</font></td></tr><tr><td ALIGN='LEFT'>end_date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>End Date</font></td></tr><tr><td ALIGN='LEFT'>recurrence (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Recurrence Frequency *</font></td></tr></table>> shape = "Mrecord"   ];
	"classification" [style=filled fillcolor = moccasin   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>classification (iHRIS_Classification) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!</font></td></tr><tr><td ALIGN='LEFT'>description (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Description</font></td></tr><tr><td ALIGN='LEFT'>code (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Code</font></td></tr></table>> shape = "Mrecord"   ];
	"competency" [style=filled fillcolor = palegreen   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>competency (iHRIS_Competency) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!∈ {competency_type}</font></td></tr><tr><td ALIGN='LEFT'>competency_type (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Competency Type *</font></td></tr><tr><td ALIGN='LEFT'>notes (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Notes</font></td></tr></table>> shape = "Mrecord"   ];
	"confirmation" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>confirmation (iHRIS_Confirmation) </td></tr><tr><td ALIGN='LEFT'>valid (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Valid *</font></td></tr><tr><td ALIGN='LEFT'>confirmation_type (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Confirmation Type *,!∈ {parent}</font></td></tr><tr><td ALIGN='LEFT'>date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Date *</font></td></tr><tr><td ALIGN='LEFT'>record (DOCUMENT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Record</font></td></tr></table>> shape = "Mrecord"   ];
	"confirmation_type" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>confirmation_type (iHRIS_ConfirmationType) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>probation_period (INT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Probationary Period (Months) *</font></td></tr><tr><td ALIGN='LEFT'>job (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Associated Job</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!∈ {job}</font></td></tr></table>> shape = "Mrecord"   ];
	"contact" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>contact (iHRIS_Contact) </td></tr><tr><td ALIGN='LEFT'>address (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Mailing Address</font></td></tr><tr><td ALIGN='LEFT'>telephone (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Telephone Number</font></td></tr><tr><td ALIGN='LEFT'>mobile_phone (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Mobile Phone Number</font></td></tr><tr><td ALIGN='LEFT'>alt_telephone (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Alternate Telephone Number</font></td></tr><tr><td ALIGN='LEFT'>fax (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Fax Number</font></td></tr><tr><td ALIGN='LEFT'>email (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Email Address</font></td></tr><tr><td ALIGN='LEFT'>notes (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Notes</font></td></tr></table>> shape = "Mrecord"   ];
	"continuing_education" [style=filled fillcolor = lavender   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>continuing_education (iHRIS_ContinuingEducation) </td></tr><tr><td ALIGN='LEFT'>continuing_education_course (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Continuing Education Course *</font></td></tr><tr><td ALIGN='LEFT'>credit_hours (INT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Credit Hours *</font></td></tr><tr><td ALIGN='LEFT'>start_date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Start Date *</font></td></tr><tr><td ALIGN='LEFT'>end_date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>End Date *</font></td></tr></table>> shape = "Mrecord"   ];
	"continuing_education_course" [style=filled fillcolor = lavender   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>continuing_education_course (iHRIS_ContinuingEducationCourse) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *</font></td></tr><tr><td ALIGN='LEFT'>credit_hours (INT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Credit Hours *</font></td></tr></table>> shape = "Mrecord"   ];
	"country" [style=filled fillcolor = plum2   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>country (iHRIS_Country) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!</font></td></tr><tr><td ALIGN='LEFT'>alpha_two (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>2 Character Alpha Code *,!</font></td></tr><tr><td ALIGN='LEFT'>code (INT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>ISO Numeric Code</font></td></tr><tr><td ALIGN='LEFT'>primary (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Primary Country</font></td></tr><tr><td ALIGN='LEFT'>location (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Use for Location Selection</font></td></tr></table>> shape = "Mrecord"   ];
	"county" [style=filled fillcolor = plum2   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>county (iHRIS_County) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!∈ {district}</font></td></tr><tr><td ALIGN='LEFT'>district (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>District *</font></td></tr></table>> shape = "Mrecord"   ];
	"cron_report" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>cron_report (iHRIS_UserCronReport) </td></tr><tr><td ALIGN='LEFT'>report_view (ENUM)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Report View *,!∈ {parent}</font></td></tr><tr><td ALIGN='LEFT'>cron_type (ENUM)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Frequency *</font></td></tr></table>> shape = "Mrecord"   ];
	"csd_address_components" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>csd_address_components (SVS_CodedList) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!</font></td></tr><tr><td ALIGN='LEFT'>code (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Code *</font></td></tr><tr><td ALIGN='LEFT'>codeSystem (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Code System *</font></td></tr></table>> shape = "Mrecord"   ];
	"csd_address_type" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>csd_address_type (SVS_CodedList) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!</font></td></tr><tr><td ALIGN='LEFT'>code (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Code *</font></td></tr><tr><td ALIGN='LEFT'>codeSystem (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Code System *</font></td></tr></table>> shape = "Mrecord"   ];
