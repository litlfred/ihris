      "@id": "https://litlfred.github.io/ihris/ihris-common/ns#glossary/code-list-isco_08_minor",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "iHRIS 4.3.3 code list: isco_08_minor",
      "skos:definition": "The `isco_08_minor` code list as iHRIS 4.3.3 ships it by default: 130 codes from ihris-common/module/isco-08-major-01, ihris-common/module/isco-08-major-02, ihris-common/module/isco-08-major-03, ihris-common/module/isco-08-major-04, ihris-common/module/isco-08-major-05, ihris-common/module/isco-08-major-06, ihris-common/module/isco-08-major-07, ihris-common/module/isco-08-major-08, ihris-common/module/isco-08-major-09. Each term's notation is the iHRIS record id and its label the record's `name`. The source gives no definitions, so every term is a candidate. 130 term(s) have exactMatch to ISCO-08 in ESCO (European Commission) by ValueSet identity: the ValueSet ihris-isco-08-minor binds this list to http://www.ilo.org/public/english/bureau/stat/isco/isco08/, so each code is that system's code. No ConceptMap records it; the basis was accepted by the owner's ruling of 2026-09-24 (ihris PR #19). The IRIs follow the publisher's pattern and were not dereferenced.",
      "dcterms:hasVersion": "4.3.3",
      "dcterms:source": "src/ihris-common/data-lists/4.3.3/isco_08_minor.json (iHRIS 4.3.3, MD5-verified release)",
      "dcterms:license": "https://www.gnu.org/licenses/gpl-3.0.html"
    },
