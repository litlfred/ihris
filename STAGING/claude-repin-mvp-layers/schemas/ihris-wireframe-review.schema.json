{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-wireframe-review.schema.json",
  "title": "ihris-wireframe-review/v1",
  "description": "One reviewer's blind, per-criterion entries on wireframe candidates: pass, warn or fail with a reason, never a score (wireframe-design-review step R_Review).",
  "type": "object",
  "required": [
    "reviewer",
    "round",
    "entries"
  ],
  "properties": {
    "reviewer": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "recordedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "method": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate",
          "criterion",
          "result",
          "reason"
        ],
        "properties": {
          "candidate": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "factualIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate",
          "severity",
          "issue"
        ],
        "properties": {
          "candidate": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "minor",
              "major"
            ]
          },
          "issue": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "verified": {
      "type": "string"
    },
    "choice": {
      "type": "object",
      "required": [
        "answer"
      ],
      "properties": {
        "answer": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
