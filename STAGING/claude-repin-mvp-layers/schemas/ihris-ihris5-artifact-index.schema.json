{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-ihris5-artifact-index.schema.json",
  "title": "ihris-ihris5-artifact-index/v1",
  "description": "GENERATED by src/tools/map_ihris5.py --artifacts: every resource SUSHI compiles for the iHRIS 5 IG this folio builds and publishes (ihris5.json `source.path`, at /ihris/ihris5/), keyed by its artefact page as fhir-harness names it (artifactPageName: <resourceType>-<id>), with its canonical url, the compiled file's sha256 and the FSH definition it came from (SUSHI's fsh-index). The site resolves every link into the IG through this file and never composes a key from a name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "_comment",
    "source",
    "sushi",
    "ig",
    "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "ihris-ihris5-artifact-index/v1"
    },
    "_comment": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "iHRIS/iHRIS"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "sushi": {
      "type": "string"
    },
    "ig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "site",
        "pages"
      ],
      "properties": {
        "id": {
          "enum": [
            "ig",
            "manage",
            "qualify"
          ]
        },
        "path": {
          "type": "string"
        },
        "site": {
          "type": "string",
          "description": "Where the IG is deployed, relative to the site root (build_site.SEPARATELY_DEPLOYED)."
        },
        "pages": {
          "type": "string",
          "description": "The artefact pages' directory under the IG site."
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "resourceType",
          "id",
          "file",
          "sha256"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "resourceType": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "The compiled file under fsh-generated/resources/."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fsh": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "file",
              "lines"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "description": "Path in iHRIS/iHRIS."
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    }
  }
}
