             fhir:CodeSystem.concept.display [ fhir:value "foster father" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "The player of the role (parent) who is a male state-certified caregiver responsible for the scoper (child) who has been placed in the parent's care. The placement of the child is usually arranged through the government or a social-service agency, and temporary.          The state, via a jurisdiction recognized child protection agency, stands as in loco parentis to the child, making all legal decisions while the foster parent is responsible for the day-to-day care of the specified child." ]
           ], [
             fhir:index 1 ;
             fhir:CodeSystem.concept.code [ fhir:value "NFTH" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "natural father" ] ;
