     ] ;
     fhir:CodeSystem.concept.concept [
       fhir:index 0 ;
       fhir:CodeSystem.concept.code [ fhir:value "_DedicatedServiceDeliveryLocationRoleType" ] ;
       fhir:CodeSystem.concept.display [ fhir:value "DedicatedServiceDeliveryLocationRoleType" ] ;
       fhir:CodeSystem.concept.definition [ fhir:value "A role of a place that further classifies a setting that is intended to house the provision of services." ] ;
       fhir:CodeSystem.concept.property [
         fhir:index 0 ;
         fhir:CodeSystem.concept.property.code [ fhir:value "notSelectable" ] ;
         fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
       ] ;
       fhir:CodeSystem.concept.concept [
         fhir:index 0 ;
         fhir:CodeSystem.concept.code [ fhir:value "_DedicatedClinicalLocationRoleType" ] ;
         fhir:CodeSystem.concept.display [ fhir:value "DedicatedClinicalLocationRoleType" ] ;
         fhir:CodeSystem.concept.definition [ fhir:value "A role of a place that further classifies the clinical setting (e.g., cardiology clinic, primary care clinic, rehabilitation hospital, skilled nursing facility) in which care is delivered during an encounter." ] ;
         fhir:CodeSystem.concept.property [
           fhir:index 0 ;
           fhir:CodeSystem.concept.property.code [ fhir:value "notSelectable" ] ;
           fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
         ] ;
         fhir:CodeSystem.concept.concept [
           fhir:index 0 ;
           fhir:CodeSystem.concept.code [ fhir:value "DX" ] ;
           fhir:CodeSystem.concept.display [ fhir:value "Diagnostics or therapeutics unit" ] ;
           fhir:CodeSystem.concept.definition [ fhir:value "A practice setting where diagnostic procedures or therapeutic interventions are performed" ] ;
           fhir:CodeSystem.concept.concept [
             fhir:index 0 ;
             fhir:CodeSystem.concept.code [ fhir:value "CVDX" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "Cardiovascular diagnostics or therapeutics unit" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "A practice setting where cardiovascular diagnostic procedures or therapeutic interventions are performed (e.g., cardiac catheterization lab, echocardiography suite)" ] ;
             fhir:CodeSystem.concept.concept [
               fhir:index 0 ;
               fhir:CodeSystem.concept.code [ fhir:value "CATH" ] ;
               fhir:CodeSystem.concept.display [ fhir:value "Cardiac catheterization lab" ] ;
               fhir:CodeSystem.concept.definition [ fhir:value "Cardiac catheterization lab" ]
             ], [
               fhir:index 1 ;
               fhir:CodeSystem.concept.code [ fhir:value "ECHO" ] ;
               fhir:CodeSystem.concept.display [ fhir:value "Echocardiography lab" ] ;
               fhir:CodeSystem.concept.definition [ fhir:value "Echocardiography lab" ]
             ]
           ], [
             fhir:index 1 ;
             fhir:CodeSystem.concept.code [ fhir:value "GIDX" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "Gastroenterology diagnostics or therapeutics lab" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "A practice setting where GI procedures (such as endoscopies) are performed" ] ;
             fhir:CodeSystem.concept.concept [
               fhir:index 0 ;
               fhir:CodeSystem.concept.code [ fhir:value "ENDOS" ] ;
               fhir:CodeSystem.concept.display [ fhir:value "Endoscopy lab" ] ;
               fhir:CodeSystem.concept.definition [ fhir:value "(X12N 261QD0000N)" ]
             ]
           ], [
