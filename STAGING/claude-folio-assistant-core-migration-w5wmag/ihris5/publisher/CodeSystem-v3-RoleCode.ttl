  ], [
     fhir:index 11 ;
     fhir:CodeSystem.concept.code [ fhir:value "_ResearchSubjectRoleBasis" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ResearchSubjectRoleBasis" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Specifies the administrative functionality within a formal experimental design for which the ResearchSubject role was established.  Examples: screening - role is used for pre-enrollment evaluation portion of the design; enrolled - role is used for subjects admitted to the active treatment portion of the design." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index 0 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "notSelectable" ] ;
       fhir:CodeSystem.concept.property.valueBoolean [ fhir:value "true"^^xsd:boolean ]
     ] ;
     fhir:CodeSystem.concept.concept [
       fhir:index 0 ;
       fhir:CodeSystem.concept.code [ fhir:value "ERL" ] ;
       fhir:CodeSystem.concept.display [ fhir:value "enrollment" ] ;
       fhir:CodeSystem.concept.definition [ fhir:value "Definition:The specific role being played by a research subject participating in the active treatment or primary data collection portion of a research study." ]
     ], [
       fhir:index 1 ;
       fhir:CodeSystem.concept.code [ fhir:value "SCN" ] ;
       fhir:CodeSystem.concept.display [ fhir:value "screening" ] ;
       fhir:CodeSystem.concept.definition [ fhir:value "Definition:The specific role being played by a research subject participating in the pre-enrollment evaluation portion of  a research study." ]
     ]
  ], [
     fhir:index 12 ;
     fhir:CodeSystem.concept.code [ fhir:value "_ServiceDeliveryLocationRoleType" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "ServiceDeliveryLocationRoleType" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "A role of a place that further classifies the setting (e.g., accident site, road side, work site, community location) in which services are delivered." ] ;
     fhir:CodeSystem.concept.property [
       fhir:index 0 ;
       fhir:CodeSystem.concept.property.code [ fhir:value "notSelectable" ] ;
