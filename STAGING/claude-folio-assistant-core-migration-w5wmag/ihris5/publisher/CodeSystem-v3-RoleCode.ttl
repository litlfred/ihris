           fhir:CodeSystem.concept.property.valueCode [ fhir:value "INJWKR" ]
         ], [
           fhir:index 3 ;
           fhir:CodeSystem.concept.property.code [ fhir:value "child" ] ;
           fhir:CodeSystem.concept.property.valueCode [ fhir:value "DIFFABL" ]
         ], [
           fhir:index 4 ;
           fhir:CodeSystem.concept.property.code [ fhir:value "child" ] ;
           fhir:CodeSystem.concept.property.valueCode [ fhir:value "WARD" ]
         ] ;
         fhir:CodeSystem.concept.concept [
           fhir:index 0 ;
           fhir:CodeSystem.concept.code [ fhir:value "INDIG" ] ;
           fhir:CodeSystem.concept.display [ fhir:value "member of an indigenous people" ] ;
           fhir:CodeSystem.concept.definition [ fhir:value "Description: A person playing the role of program eligible under a program based on aboriginal ancestry or as a member of an aboriginal community.                    Discussion: This CoveredPartyRoleType.code is typically used when the CoveredPartyRole class code is \"program eligible\" and the person's status as a member of an indigenous people meets jurisdictional or program criteria." ]
         ], [
           fhir:index 1 ;
           fhir:CodeSystem.concept.code [ fhir:value "MIL" ] ;
           fhir:CodeSystem.concept.display [ fhir:value "military" ] ;
           fhir:CodeSystem.concept.definition [ fhir:value "Definition: A person playing the role of program eligible under a program based on military status.                    Discussion:  This CoveredPartyRoleType.code is typically used when the CoveredPartyRole class code is either \"program eligible\" or \"subscriber\" and the person's status as a member of the military meets jurisdictional or program criteria" ] ;
           fhir:CodeSystem.concept.concept [
             fhir:index 0 ;
             fhir:CodeSystem.concept.code [ fhir:value "ACTMIL" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "active duty military" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "Description: A person playing the role of program eligible under a program based on active military status.                    Discussion: This CoveredPartyRoleType.code is typically used when the CoveredPartyRole class code is either \"program eligible\" or \"subscriber\" and the persons status as active duty military meets jurisdictional or program criteria." ]
           ], [
             fhir:index 1 ;
             fhir:CodeSystem.concept.code [ fhir:value "RETMIL" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "retired military" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "Description: A person playing the role of program eligible under a program based on retired military status.                    Discussion: This CoveredPartyRoleType.code is typically used when the CoveredPartyRole class code is either \"program eligible\" or \"subscriber\" and the persons status as retired military meets jurisdictional or program criteria." ]
           ], [
             fhir:index 2 ;
             fhir:CodeSystem.concept.code [ fhir:value "VET" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "veteran" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "Description: A person playing the role of program eligible under a program based on status as a military veteran.                    Discussion: This CoveredPartyRoleType.code is typically used when the CoveredPartyRole class code is either \"program eligible\" or \"subscriber\" and the persons status as a veteran meets jurisdictional or program criteria." ]
           ]
         ]
       ], [
         fhir:index 4 ;
