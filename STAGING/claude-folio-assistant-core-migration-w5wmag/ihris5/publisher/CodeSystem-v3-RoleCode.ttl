       ], [
         fhir:index 4 ;
         fhir:CodeSystem.concept.code [ fhir:value "SIGOTHR" ] ;
         fhir:CodeSystem.concept.display [ fhir:value "significant other" ] ;
         fhir:CodeSystem.concept.definition [ fhir:value "A person who is important to one's well being; especially a spouse or one in a similar relationship.  (The player is the one who is important)" ] ;
         fhir:CodeSystem.concept.concept [
           fhir:index 0 ;
           fhir:CodeSystem.concept.code [ fhir:value "DOMPART" ] ;
           fhir:CodeSystem.concept.display [ fhir:value "domestic partner" ] ;
           fhir:CodeSystem.concept.definition [ fhir:value "The player of the role cohabits with the scoping person but is not the scoping person's spouse." ]
         ], [
           fhir:index 1 ;
           fhir:CodeSystem.concept.code [ fhir:value "FMRSPS" ] ;
           fhir:CodeSystem.concept.display [ fhir:value "former spouse" ] ;
           fhir:CodeSystem.concept.definition [ fhir:value "Player of the role was previously joined to the scoping person in marriage and this marriage is now dissolved and inactive.                    Usage Note: This is significant to indicate as some jurisdictions have different legal requirements for former spouse to access the patient's record, from a general friend." ]
         ], [
           fhir:index 2 ;
           fhir:CodeSystem.concept.code [ fhir:value "SPS" ] ;
