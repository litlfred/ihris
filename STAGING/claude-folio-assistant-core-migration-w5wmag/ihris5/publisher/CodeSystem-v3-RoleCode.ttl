             fhir:CodeSystem.concept.display [ fhir:value "Radiology diagnostics or therapeutics unit" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "A practice setting where radiology services (diagnostic or therapeutic) are provided            (X12N 261QR0200N)" ] ;
             fhir:CodeSystem.concept.concept [
               fhir:index 0 ;
               fhir:CodeSystem.concept.code [ fhir:value "RADO" ] ;
               fhir:CodeSystem.concept.display [ fhir:value "Radiation oncology unit" ] ;
               fhir:CodeSystem.concept.definition [ fhir:value "(X12N 261QX0203N)" ]
             ], [
               fhir:index 1 ;
               fhir:CodeSystem.concept.code [ fhir:value "RNEU" ] ;
               fhir:CodeSystem.concept.display [ fhir:value "Neuroradiology unit" ] ;
               fhir:CodeSystem.concept.definition [ fhir:value "Neuroradiology unit" ]
             ]
           ]
         ], [
           fhir:index 1 ;
           fhir:CodeSystem.concept.code [ fhir:value "HOSP" ] ;
           fhir:CodeSystem.concept.display [ fhir:value "Hospital" ] ;
           fhir:CodeSystem.concept.definition [ fhir:value "An acute care institution that provides medical, surgical, or psychiatric care and treatment for the sick or the injured." ] ;
           fhir:CodeSystem.concept.concept [
             fhir:index 0 ;
             fhir:CodeSystem.concept.code [ fhir:value "CHR" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "Chronic Care Facility" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "(1) A hospital including a physical plant and personnel that provides multidisciplinary diagnosis and treatment for diseases that have one or more of the following characteristics: is permanent; leaves residual disability; is caused by nonreversible pathological alteration; requires special training of the patient for rehabilitation; and/or may be expected to require a long period of supervision or care. In addition, patients require the safety, security, and shelter of these specialized inpatient or partial hospitalization settings. (2) A hospital that provides medical and skilled nursing services to patients with long-term illnesses who are not in an acute phase but who require an intensity of services not available in nursing homes" ]
           ], [
             fhir:index 1 ;
             fhir:CodeSystem.concept.code [ fhir:value "GACH" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "Hospitals; General Acute Care Hospital" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "(X12N 282N00000N)" ]
           ], [
             fhir:index 2 ;
             fhir:CodeSystem.concept.code [ fhir:value "MHSP" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "Military Hospital" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "A health care facility operated by the Department of Defense or other military operation." ]
           ], [
             fhir:index 3 ;
             fhir:CodeSystem.concept.code [ fhir:value "PSYCHF" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "Psychatric Care Facility" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "Healthcare facility that cares for patients with psychiatric illness(s)." ]
           ], [
             fhir:index 4 ;
             fhir:CodeSystem.concept.code [ fhir:value "RH" ] ;
             fhir:CodeSystem.concept.display [ fhir:value "Rehabilitation hospital" ] ;
             fhir:CodeSystem.concept.definition [ fhir:value "(X12N 283X00000N)" ] ;
             fhir:CodeSystem.concept.concept [
               fhir:index 0 ;
               fhir:CodeSystem.concept.code [ fhir:value "RHAT" ] ;
               fhir:CodeSystem.concept.display [ fhir:value "addiction treatment center" ] ;
               fhir:CodeSystem.concept.definition [ fhir:value "Description: A location that plays the role of delivering services which may include life training and/or social support to people with addictions." ]
             ], [
               fhir:index 1 ;
               fhir:CodeSystem.concept.code [ fhir:value "RHII" ] ;
               fhir:CodeSystem.concept.display [ fhir:value "intellectual impairment center" ] ;
               fhir:CodeSystem.concept.definition [ fhir:value "Description: A location that plays the role of delivering services which may include adaptation, rehabilitation and social integration services for people with intellectual and/or pervasive development disorders such as autism or severe behaviour disorder." ]
             ], [
               fhir:index 2 ;
               fhir:CodeSystem.concept.code [ fhir:value "RHMAD" ] ;
               fhir:CodeSystem.concept.display [ fhir:value "parents with adjustment difficulties center" ] ;
               fhir:CodeSystem.concept.definition [ fhir:value "Description: A location that plays the role of delivering services which may social support services for adolescents who are pregnant or have child and are experiencing adaptation issues/difficulties in their current or eventual parenting role." ]
             ], [
               fhir:index 3 ;
               fhir:CodeSystem.concept.code [ fhir:value "RHPI" ] ;
               fhir:CodeSystem.concept.display [ fhir:value "physical impairment center" ] ;
               fhir:CodeSystem.concept.definition [ fhir:value "Description: A location that plays the role of delivering services which may include adaptation, rehabilitation and social integration services for people with physical impairments." ] ;
