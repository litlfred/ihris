         fhir:CodeSystem.concept.display [ fhir:value "SubscriberCoveredPartyRoleType" ] ;
         fhir:CodeSystem.concept.definition [ fhir:value "Description: A role recognized through the eligibility of a party to play a subscriber for benefits covered or provided under a health insurance policy." ] ;
         fhir:CodeSystem.concept.property [
           fhir:index 0 ;
           fhir:CodeSystem.concept.property.code [ fhir:value "notSelectable" ] ;
