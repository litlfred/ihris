{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-site-theme-dark.schema.json",
  "title": "ihris-site-theme-dark/v1",
  "description": "The ihris site's dark scheme, DERIVED (src/tools/derive_dark_theme.py) from the measured light theme (ihris-site-theme/v1) and the owner's grounds (ihris-site-theme-dark-grounds/v1): each foreground keeps its light role's hue and saturation and takes the lowest lightness at or above it that reaches its target on every ground. Generated; never edited.",
  "type": "object",
  "required": ["$schema", "id", "title", "derivedFrom", "licence", "wcag", "grounds", "logo", "applied", "derivations"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "ihris-site-theme-dark/v1"},
    "id": {"type": "string"},
    "title": {"type": "string"},
    "derivedFrom": {"type": "object", "required": ["theme", "grounds", "rule"]},
    "licence": {"type": "object", "required": ["id", "basis", "attribution"]},
    "wcag": {"type": "object", "required": ["target", "targets"]},
    "grounds": {"type": "object", "required": ["page", "panel", "raised", "rule"], "additionalProperties": {"type": "string", "pattern": "^#[0-9a-f]{6}$"}},
    "logo": {"enum": ["invert", "tile"]},
    "applied": {"type": "object", "additionalProperties": {"type": "string"}},
    "derivations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "light", "applied", "target", "contrast"],
        "additionalProperties": false,
        "properties": {
          "role": {"type": "string"},
          "light": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
          "applied": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
          "target": {"type": "number"},
          "contrast": {"type": "object", "required": ["panel", "raised"], "additionalProperties": {"type": "number"}}
        }
      }
    }
  }
}
