{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-wireframe-decision.schema.json",
  "title": "ihris-wireframe-decision/v1",
  "description": "The choice between surviving candidates, with the reason each lost (Process_OptionsAnalysis, called from Call_Choose).",
  "type": "object",
  "required": [
    "process",
    "round",
    "decidedBy",
    "decidedOn",
    "options"
  ],
  "properties": {
    "process": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "decidedBy": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "decidedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "outcome",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "iterate": {
      "type": "object",
      "required": [
        "reviseIntent"
      ],
      "properties": {
        "reviseIntent": {
          "type": "boolean"
        },
        "next": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "carryForward": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
