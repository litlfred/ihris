{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-dak-excluded.schema.json",
  "title": "ihris-dak-excluded/v1",
  "description": "What the data dictionary leaves out and why (src/ihris-data-dictionary/excluded.json).",
  "type": "object",
  "required": [
    "classesByScope",
    "excludedClasses",
    "excludedFields"
  ],
  "properties": {
    "classesByScope": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "excludedClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "scope"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "excludedFields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "field",
          "reason"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
