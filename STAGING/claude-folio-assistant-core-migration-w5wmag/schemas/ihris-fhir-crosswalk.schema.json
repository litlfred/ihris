{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-fhir-crosswalk.schema.json",
  "title": "ihris-fhir-crosswalk/v1",
  "description": "GENERATED by src/tools/map_ihris5.py (F4, bean ihris-7gl8): each iHRIS 4 logical model matched, per iHRIS 5 IG, to a profile, and its elements to the profile's elements, by name and label equality only, each candidate with its evidence. Tiers: exact (one candidate, type-compatible), accepted (the owner's decision in src/ihris-data-dictionary/authored/), ambiguous, none. The StructureMaps in src/ihris-4-on-fhir/input/fsh/maps/ are generated from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "_comment",
    "index",
    "source",
    "method",
    "igs",
    "counts",
    "models"
  ],
  "properties": {
    "$schema": {
      "const": "ihris-fhir-crosswalk/v1"
    },
    "_comment": {
      "type": "string"
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "logicalModels",
        "elements"
      ],
      "properties": {
        "canonical": {
          "const": "https://litlfred.github.io/ihris/dak"
        },
        "logicalModels": {
          "type": "integer"
        },
        "elements": {
          "type": "integer"
        }
      }
    },
    "method": {
      "type": "object"
    },
    "igs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "title",
          "canonical",
          "compile"
        ],
        "properties": {
          "id": {
            "enum": [
              "ig",
              "manage",
              "qualify"
            ]
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical": {
            "type": [
              "string",
              "null"
            ]
          },
          "compile": {
            "type": "object",
            "properties": {
              "errors": {
                "type": "integer"
              },
              "warnings": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "ig",
          "manage",
          "qualify"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "models",
          "elements",
          "structureMaps"
        ],
        "properties": {
          "models": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exact",
              "accepted",
              "ambiguous",
              "none"
            ],
            "properties": {
              "exact": {
                "type": "integer",
                "minimum": 0
              },
              "accepted": {
                "type": "integer",
                "minimum": 0
              },
              "ambiguous": {
                "type": "integer",
                "minimum": 0
              },
              "none": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "elements": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exact",
              "accepted",
              "ambiguous",
              "none"
            ],
            "properties": {
              "exact": {
                "type": "integer",
                "minimum": 0
              },
              "accepted": {
                "type": "integer",
                "minimum": 0
              },
              "ambiguous": {
                "type": "integer",
                "minimum": 0
              },
              "none": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "structureMaps": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "url",
          "class",
          "file",
          "elements",
          "targets"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "elements": {
            "type": "integer"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ig",
                "tier",
                "candidates"
              ],
              "properties": {
                "ig": {
                  "enum": [
                    "ig",
                    "manage",
                    "qualify"
                  ]
                },
                "tier": {
                  "enum": [
                    "exact",
                    "accepted",
                    "ambiguous",
                    "none"
                  ]
                },
                "profile": {
                  "type": "string"
                },
                "profileName": {
                  "type": "string"
                },
                "decidedBy": {
                  "type": "string"
                },
                "candidates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "profile",
                      "name",
                      "evidence"
                    ],
                    "properties": {
                      "profile": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "kind"
                          ],
                          "properties": {
                            "kind": {
                              "enum": [
                                "name",
                                "majority",
                                "label"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "structureMap": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "url",
                    "file"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    }
                  }
                },
                "elements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "element",
                      "field",
                      "labels",
                      "type",
                      "tier",
                      "candidates"
                    ],
                    "properties": {
                      "element": {
                        "type": "string"
                      },
                      "field": {
                        "type": "string"
                      },
                      "labels": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "type": {
                        "type": "string"
                      },
                      "tier": {
                        "enum": [
                          "exact",
                          "accepted",
                          "ambiguous",
                          "none"
                        ]
                      },
                      "target": {
                        "type": "string"
                      },
                      "decidedBy": {
                        "type": "string"
                      },
                      "contention": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "candidates": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "path",
                            "types",
                            "typeCompatible",
                            "evidence"
                          ],
                          "properties": {
                            "path": {
                              "type": "string"
                            },
                            "types": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "typeCompatible": {
                              "type": "boolean"
                            },
                            "evidence": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "kind"
                                ],
                                "properties": {
                                  "kind": {
                                    "enum": [
                                      "name",
                                      "majority",
                                      "label"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
