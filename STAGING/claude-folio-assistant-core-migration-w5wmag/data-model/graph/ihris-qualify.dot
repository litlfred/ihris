	"competency" [style=filled fillcolor = palegreen   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>competency (iHRIS_Competency) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!∈ {competency_type}</font></td></tr><tr><td ALIGN='LEFT'>competency_type (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Competency Type *</font></td></tr><tr><td ALIGN='LEFT'>notes (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Notes</font></td></tr></table>> shape = "Mrecord"   ];
