digraph g {
	graph [
		fontsize=50
		labelloc=t
		overlap=false
		rankdir=LR
		splines=true
		label="iHRIS Qualify - 4.3.3"
	];
	ratio = auto;
	"splitter+establishment+job_cadre" [shape=point size = 1 label = ""  ] ;
	"splitter+facility+location" [shape=point size = 1 label = ""  ] ;
	"splitter+health_facility+location" [shape=point size = 1 label = ""  ] ;
	"splitter+person+residence" [shape=point size = 1 label = ""  ] ;
	"splitter+scheduled_training_course+location" [shape=point size = 1 label = ""  ] ;
	"splitter+training_funder+location" [shape=point size = 1 label = ""  ] ;
	"splitter+training_institution+location" [shape=point size = 1 label = ""  ] ;
	"archived_report" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>archived_report (I2CE_ArchivedReport) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>report (DOCUMENT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Report</font></td></tr><tr><td ALIGN='LEFT'>date (DATE_YMD)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Generation Date *</font></td></tr><tr><td ALIGN='LEFT'>report_view (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Report View !∈ {date}</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Title *</font></td></tr></table>> shape = "Mrecord"   ];
	"cadre" [style=filled fillcolor = cadetblue1   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>cadre (iHRIS_Cadre) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!</font></td></tr><tr><td ALIGN='LEFT'>isco (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>ISCO Classification Code</font></td></tr><tr><td ALIGN='LEFT'>qualification (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Minimum Qualification Required *</font></td></tr></table>> shape = "Mrecord"   ];
	"certificate" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>certificate (iHRIS_Certificate) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>name (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Name *,!∈ {academic_level}</font></td></tr><tr><td ALIGN='LEFT'>academic_level (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Academic Level *</font></td></tr></table>> shape = "Mrecord"   ];
