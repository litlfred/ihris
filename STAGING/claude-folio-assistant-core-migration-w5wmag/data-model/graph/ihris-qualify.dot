	"user_alert" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>user_alert (iHRIS_UserAlert) </td></tr><tr><td ALIGN='LEFT'>alert_type (ENUM)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Alert Type *</font></td></tr><tr><td ALIGN='LEFT'>message (STRING_MLINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Message *</font></td></tr><tr><td ALIGN='LEFT'>time_sent (DATE_TIME)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Time Sent *</font></td></tr><tr><td ALIGN='LEFT'>time_ack (DATE_TIME)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Time Acknowledged</font></td></tr><tr><td ALIGN='LEFT'>repeated (INT)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Repeated *</font></td></tr><tr><td ALIGN='LEFT'>link (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Link (URL)</font></td></tr><tr><td ALIGN='LEFT'>link_text (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Link Text</font></td></tr></table>> shape = "Mrecord"   ];
	"user_map" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>user_map (iHRIS_UserMap) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>username (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Username *,!</font></td></tr></table>> shape = "Mrecord"   ];
	"user_request" [style=filled fillcolor = ivory3   label =<<table border='0' cellborder='0'><tr><td BGCOLOR='white' BORDER='1'>user_request (I2CE_User_Request) </td></tr><tr><td ALIGN='LEFT'>remap (REMAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Remapped Value</font></td></tr><tr><td ALIGN='LEFT'>i2ce_hidden (YESNO)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Hide</font></td></tr><tr><td ALIGN='LEFT'>username (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Username *</font></td></tr><tr><td ALIGN='LEFT'>password (STRING_PASS)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Password (leave blank to keep the same password)</font></td></tr><tr><td ALIGN='LEFT'>role (MAP)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Role</font></td></tr><tr><td ALIGN='LEFT'>request_number (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Request Number *,!</font></td></tr><tr><td ALIGN='LEFT'>verified (BOOL)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>Email Verifed</font></td></tr><tr><td ALIGN='LEFT'>email (STRING_LINE)</td></tr><tr><td ALIGN='LEFT'>  <font color='grey30'>E-mail Address *,!</font></td></tr></table>> shape = "Mrecord"   ];
