      "@type": "fhir:CodeSystem",
      "dcterms:identifier": "CodeSystem/3654",
      "dcterms:title": "degreeLicenseCertificate",
      "dcterms:description": "Code system of concepts specifying an educational degree (e.g., MD).  Used in the CNN datatype (names and identifiers of clinicians) in Version 2 messaging.  Used in HL7 Version 2.x messaging in the CNN segment; note that in releases of HL7 prior to 2.3.1, was also used in person names (XPN), but this use was deprecated, then withdrawn in 2.7.",
      "dcterms:type": "Terminology: Code Systems",
      "schema:sameAs": {
        "@id": "http://terminology.hl7.org/CodeSystem/v2-0360"
      }
    },
