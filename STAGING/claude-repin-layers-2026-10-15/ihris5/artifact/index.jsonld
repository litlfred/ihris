      "dcterms:identifier": "CodeSystem/2103",
      "dcterms:title": "identifierType",
      "dcterms:description": "HL7-defined code system of concepts specifying type of identifier. Used in HL7 Version 2.x messaging data types CX, PLN, PPN, XCN and XON.",
      "dcterms:type": "Terminology: Code Systems",
      "schema:sameAs": {
