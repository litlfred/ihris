{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-dak-proposal.schema.json",
  "title": "ihris-dak-proposal/v1",
  "description": "An AUTHORED overlay on the derived DAK: a proposal a person makes, with its rationale and evidence, about something the source does not state (a binding, a definition, a mapping). Lives in src/ihris-data-dictionary/authored/, which no build writes. `status` moves proposed -> accepted/rejected only by the owner's decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "author",
    "date",
    "items"
  ],
  "properties": {
    "$schema": {
      "const": "ihris-dak-proposal/v1"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "statement",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "binding",
              "mapping",
              "definition",
              "upstream-observation",
              "blocked"
            ]
          },
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "rejected",
              "to-verify",
              "blocked"
            ]
          },
          "appliesTo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statement": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs": {
            "type": "string"
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "on",
              "status"
            ],
            "description": "The owner's decision that moved `status` out of proposed/to-verify. Only the owner records one.",
            "properties": {
              "by": {
                "type": "string"
              },
              "on": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "accepted",
                  "rejected"
                ]
              },
              "where": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "followUp": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Files or actions this item produced (drafts, issues, PRs)."
          },
          "candidates": {
            "type": "array",
            "description": "For a `mapping` item: the candidates the F4 matcher found (src/tools/map_ihris5.py), or a source names (the bean's examples, cited in `basis`). Nobody adds a candidate of their own.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "level",
                "model",
                "ig",
                "target",
                "basis",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "level": {
                  "enum": [
                    "model",
                    "element"
                  ]
                },
                "model": {
                  "type": "string",
                  "description": "The logical model (data-dictionary group)."
                },
                "element": {
                  "type": "string",
                  "description": "The logical-model element, for level element."
                },
                "ig": {
                  "enum": [
                    "ig",
                    "manage",
                    "qualify"
                  ]
                },
                "target": {
                  "type": "string",
                  "description": "The iHRIS 5 profile canonical (model) or element path (element)."
                },
                "basis": {
                  "type": "string",
                  "description": "`matcher`, or the source that names this candidate (e.g. `bean ihris-7gl8`)."
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "selected": {
            "type": "string",
            "description": "The candidate id the owner chose when accepting. Only the owner sets it; an accepted mapping with `selected` drives the matcher's next run."
          }
        }
      }
    }
  }
}
