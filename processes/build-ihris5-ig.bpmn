        <di:waypoint x="1295" y="165" />
        <di:waypoint x="1390" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_BuildIhris5Ig_7" bpmnElement="SF_Process_BuildIhris5Ig_7">
        <di:waypoint x="1295" y="165" />
        <di:waypoint x="1365" y="165" />
        <di:waypoint x="1365" y="335" />
        <di:waypoint x="1390" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_BuildIhris5Ig_8" bpmnElement="SF_Process_BuildIhris5Ig_8">
        <di:waypoint x="1530" y="335" />
        <di:waypoint x="1632" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_BuildIhris5Ig_9" bpmnElement="SF_Process_BuildIhris5Ig_9">
        <di:waypoint x="1530" y="165" />
        <di:waypoint x="1580" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_BuildIhris5Ig_10" bpmnElement="SF_Process_BuildIhris5Ig_10">
        <di:waypoint x="1720" y="165" />
