      <bpmndi:BPMNEdge id="Edge_SF_Process_Ihris4OnFhir_5" bpmnElement="SF_Process_Ihris4OnFhir_5">
        <di:waypoint x="960" y="165" />
        <di:waypoint x="1010" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_Ihris4OnFhir_6" bpmnElement="SF_Process_Ihris4OnFhir_6">
        <di:waypoint x="1150" y="165" />
