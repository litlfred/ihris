{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-ihris5-element-index.schema.json",
  "title": "ihris-ihris5-element-index/v1",
  "description": "GENERATED by src/tools/map_ihris5.py --index: the three iHRIS 5 IGs (iHRIS/iHRIS at the commit src/ihris5/ihris5.json pins) as SUSHI compiles them, reduced to names, element paths, labels, types and bindings, with each compiled file's sha256. What the F4 matcher reads, committed so CI can check the crosswalk without mounting iHRIS 5. No FSH, no definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "_comment",
    "source",
    "sushi",
    "igs"
  ],
  "properties": {
    "$schema": {
      "const": "ihris-ihris5-element-index/v1"
    },
    "_comment": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "licence",
        "attribution"
      ],
      "properties": {
        "repository": {
          "const": "iHRIS/iHRIS"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "licence": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "sushi": {
      "type": "string"
    },
    "igs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "title",
          "canonical",
          "compile",
          "structures",
          "questionnaires"
        ],
        "properties": {
          "id": {
            "enum": [
              "ig",
              "manage",
              "qualify"
            ]
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical": {
            "type": [
              "string",
              "null"
            ]
          },
          "compile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "errors",
              "warnings",
              "errorMessages"
            ],
            "properties": {
              "errors": {
                "type": "integer",
                "minimum": 0
              },
              "warnings": {
                "type": "integer",
                "minimum": 0
              },
              "errorMessages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "structures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "id",
                "name",
                "type",
                "file",
                "sha256",
                "elements"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "baseDefinition": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "elements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "types": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "typeFrom": {
                        "enum": [
                          "differential",
                          "r4-core"
                        ]
                      },
                      "profiles": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "binding": {
                        "type": "string"
                      },
                      "min": {
                        "type": "integer"
                      },
                      "max": {
                        "type": "string"
                      },
                      "fixedUri": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "questionnaires": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "file",
                "sha256",
                "items"
              ],
              "properties": {
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "file": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "linkId",
                      "text",
                      "definition"
                    ],
                    "properties": {
                      "linkId": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "definition": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
