{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-use-cases.schema.json",
  "title": "ihris-use-cases/v1",
  "description": "One iHRIS product's 2009 use-case model (Serlio CaseComplete report), parsed: packages holding use cases (Details fields, main success scenario, extensions, notes) and requirements, the actors, and the references the report cites but never describes (library/ihris-use-cases/<product>.json, src/tools/ingest_use_cases.py). Actors are referenced as ROLES (library/ihris-use-cases/scenarios/roles.json, folio-assistant's RoleGraphSchema); a person the report names (Assigned To, a requirement's Source) is referenced as an opaque actor (scenarios/actors/ihris-2009-staff-NN.json), identity withheld.",
  "type": "object",
  "required": ["$schema", "product", "title", "report", "source", "attribution", "counts", "withheld", "actors", "root", "dangling", "glossary"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "ihris-use-cases/v1"},
    "product": {"enum": ["common", "manage", "qualify", "plan"]},
    "title": {"type": "string"},
    "report": {
      "type": "object",
      "required": ["title", "generator", "generatedAt", "author"],
      "additionalProperties": false,
      "properties": {"title": {"type": "string"}, "generator": {"type": "string"}, "generatedAt": {"type": "string"}, "author": {"type": "string"},
        "subject": {"type": "string", "description": "The Subject of the document summary (OLE SummaryInformation), as the .doc carries it."}}
    },
    "source": {
      "type": "object",
      "required": ["file", "md5", "sha256", "extractedWith", "textSha256", "manifest"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string", "pattern": "\\.doc$"},
        "md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "extractedWith": {"type": "string"},
        "textSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest": {"type": "string"}
      }
    },
    "attribution": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object",
      "required": ["useCases", "actors", "requirements", "packages", "steps", "extensions"],
      "additionalProperties": false,
      "properties": {
        "useCases": {"type": "integer", "minimum": 0}, "actors": {"type": "integer", "minimum": 0},
        "requirements": {"type": "integer", "minimum": 0}, "packages": {"type": "integer", "minimum": 1},
        "steps": {"type": "integer", "minimum": 0}, "extensions": {"type": "integer", "minimum": 0}
      }
    },
    "withheld": {
      "type": "array",
      "items": {
        "type": "object", "required": ["field", "why", "count"], "additionalProperties": false,
        "properties": {"field": {"enum": ["assignedTo", "source"]}, "why": {"type": "string", "description": "what the field held, and that each value is now referenced by an opaque actor"}, "count": {"type": "integer", "minimum": 1, "description": "how many records carry the field; each carries an {actor} reference"}}
      }
    },
    "actors": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
    "root": {"$ref": "#/$defs/package"},
    "dangling": {"type": "array", "items": {"$ref": "#/$defs/dangling"}},
    "glossary": {
      "type": "object",
      "description": "The report's glossary. CaseComplete's report subject names one; `found` says whether the report text holds a glossary section, and `terms` are its entries, verbatim. No term is invented: when none is found, `terms` is empty and `note` says what was checked (src/tools/build_glossary.py reads this).",
      "required": ["claimedBy", "found", "terms", "note"],
      "additionalProperties": false,
      "properties": {
        "claimedBy": {"type": ["string", "null"], "description": "Where the report says it holds a glossary (its document summary's Subject), or null when it does not say so."},
        "found": {"type": "boolean"},
        "terms": {"type": "array", "items": {"type": "object", "required": ["term", "definition"], "additionalProperties": false,
                                              "properties": {"term": {"type": "string", "minLength": 1}, "definition": {"type": "string", "minLength": 1}}}},
        "note": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "text": {"type": ["string", "null"]},
    "roleId": {"type": "string", "pattern": "^ihris-a-[a-z]+\\d+$", "description": "a Role in library/ihris-use-cases/scenarios/roles.json: ihris- and the actor id, lower case"},
    "actorRef": {
      "type": "object", "required": ["actor"], "additionalProperties": false,
      "description": "A person the report names, as an opaque actor. Who it is lives in the data store only.",
      "properties": {"actor": {"type": "string", "pattern": "^ihris-2009-staff-\\d{2}$", "description": "an actor file in library/ihris-use-cases/scenarios/actors/"}}
    },
    "note": {
      "type": "object", "required": ["text", "dateAdded", "date"], "additionalProperties": false,
      "properties": {
        "text": {"type": "string"},
        "dateAdded": {"type": ["string", "null"], "description": "as the report prints it (M/D/YYYY)"},
        "date": {"type": ["string", "null"], "format": "date"}
      }
    },
    "actor": {
      "type": "object", "required": ["id", "name", "description", "goals", "notes", "useCases", "role"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^A-[A-Z]+\\d+$"},
        "role": {"$ref": "#/$defs/roleId"},
        "name": {"type": "string"},
        "description": {"$ref": "#/$defs/text"},
        "goals": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}},
        "useCases": {
          "type": "array",
          "items": {"type": "object", "required": ["id", "title"], "additionalProperties": false,
                    "properties": {"id": {"type": "string", "pattern": "^UC-[A-Z]+\\d+$"}, "title": {"type": "string"}}}
        }
      }
    },
    "package": {
      "type": "object",
      "required": ["number", "name", "level", "description", "notes", "relatedDocuments", "packages", "useCases", "requirements"],
      "additionalProperties": false,
      "properties": {
        "number": {"type": "string", "pattern": "^\\d+(\\.\\d+)*$"},
        "name": {"type": "string"},
        "level": {"type": "integer", "minimum": 1},
        "description": {"$ref": "#/$defs/text"},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}},
        "relatedDocuments": {"type": "array", "items": {"type": "string"}},
        "packages": {"type": "array", "items": {"$ref": "#/$defs/package"}},
        "useCases": {"type": "array", "items": {"$ref": "#/$defs/useCase"}},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}
      }
    },
    "step": {
      "type": "object", "required": ["step", "text"], "additionalProperties": false,
      "properties": {"step": {"type": "integer", "minimum": 1}, "text": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}}}
    },
    "useCase": {
      "type": "object",
      "required": ["id", "title", "priority", "package", "description", "parent", "primaryActors", "supportingActors", "preconditions",
                   "successGuarantee", "level", "complexity", "status", "implementationStatus", "release", "mainSuccessScenario", "extensions"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^UC-[A-Z]+\\d+$"},
        "title": {"type": "string"},
        "priority": {"type": ["string", "null"], "pattern": "^P\\d+$"},
        "package": {"type": "string"},
        "description": {"$ref": "#/$defs/text"},
        "parent": {"$ref": "#/$defs/text"},
        "primaryActors": {"type": "array", "items": {"$ref": "#/$defs/roleId"}},
        "supportingActors": {"type": "array", "items": {"$ref": "#/$defs/roleId"}},
        "assignedTo": {"$ref": "#/$defs/actorRef"},
        "preconditions": {"$ref": "#/$defs/text"},
        "successGuarantee": {"$ref": "#/$defs/text"},
        "level": {"$ref": "#/$defs/text"},
        "complexity": {"$ref": "#/$defs/text"},
        "status": {"$ref": "#/$defs/text"},
        "implementationStatus": {"$ref": "#/$defs/text"},
        "release": {"$ref": "#/$defs/text"},
        "mainSuccessScenario": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "extensions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "atStep", "text", "steps"], "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^(\\*|\\d+(\\.\\d+)*)\\.[a-z]$"},
              "atStep": {"type": "string", "pattern": "^(\\*|\\d+(\\.\\d+)*)$"},
              "text": {"type": "string"},
              "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}}
            }
          }
        },
        "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}},
        "referencedRequirements": {
          "type": "array",
          "items": {"type": "object", "required": ["id", "type", "text"], "additionalProperties": false,
                    "properties": {"id": {"type": "string", "pattern": "^REQ-[A-Z]+\\d+$"}, "type": {"type": "string"}, "text": {"type": "string"}}}
        }
      }
    },
    "requirement": {
      "type": "object", "required": ["id", "name", "priority", "package", "description"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^REQ-[A-Z]+\\d+$"},
        "name": {"type": "string"},
        "priority": {"type": ["string", "null"], "pattern": "^P\\d+$"},
        "package": {"type": "string"},
        "description": {"$ref": "#/$defs/text"},
        "parent": {"$ref": "#/$defs/text"},
        "type": {"$ref": "#/$defs/text"},
        "status": {"$ref": "#/$defs/text"},
        "release": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/actorRef"},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}},
        "referencedBy": {"type": "array", "items": {"type": "string", "pattern": "^UC-[A-Z]+\\d+$"}}
      }
    },
    "dangling": {
      "type": "object", "required": ["id", "kind", "product", "title", "citedBy"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(UC|REQ|A)-[A-Z]+\\d+$"},
        "kind": {"enum": ["use-case", "requirement", "actor"]},
        "product": {"enum": ["common", "manage", "qualify", "plan"]},
        "title": {"type": ["string", "null"]},
        "citedBy": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
