{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-wireframe-patch.schema.json",
  "title": "ihris-wireframe-patch/v1",
  "description": "A change made to a candidate after its review, and how it was verified (so an acceptance can say what it covers).",
  "type": "object",
  "required": [
    "round",
    "after",
    "patchedOn",
    "by",
    "why",
    "patches",
    "checks"
  ],
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "after": {
      "type": "string"
    },
    "patchedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "by": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "why": {
      "type": "string"
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "answers",
          "change",
          "verified"
        ],
        "properties": {
          "answers": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "verified": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
