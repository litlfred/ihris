{
  "id": "ihris-build-site",
  "title": "Build the iHRIS-themed harness site",
  "description": "Generates the static site published at litlfred.github.io/ihris/ from committed, schema-validated data. It covers: a landing board of every instance; the data model per package and class, in the accepted wireframe H2 layout; the Launchpad sources, with series, releases (MD5), every I2CE module and the shipped data lists; iHRIS 5 as a pinned inventory; the toolkit as structure only (no licence recorded); the wiki help pages in full (GPL), with their figures and rewritten links; the data dictionary, with logical models, value sets and codes, and ISO/ISCO reports; iHRIS 4 on FHIR; and the schema index. It is themed with src/site/theme/ihris-classic.json and, through the light/dark switch, its derived dark scheme src/site/theme/ihris-classic-dark.json (Tool ihris-scheme-css, which needs bun and the mounted platform), and all links are relative. --check-links fails on any internal link that does not resolve. Needs the pinned dependencies in src/tools/requirements-site.txt.",
  "install": {
    "none": true
  },
  "invoke": {
    "shell": "python3 src/tools/build_site.py"
  },
  "io": {
    "inputs": [
      {
        "name": "out",
        "schema": "https://www.w3.org/2001/XMLSchema#string",
        "required": false,
        "arg": {
          "flag": "--out"
        }
      },
      {
        "name": "check-links",
        "schema": "https://www.w3.org/2001/XMLSchema#boolean",
        "required": false,
        "arg": {
          "flag": "--check-links"
        }
      },
      {
        "name": "catalogue",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/catalogue",
        "required": false,
        "description": "Read from src/*/catalogue/"
      },
      {
        "name": "modules",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/modules",
        "required": false,
        "description": "Read from src/*/modules/"
      },
      {
        "name": "dataModel",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/dataModel",
        "required": false,
        "description": "Read from src/*/data-model/4.3.3/"
      },
      {
        "name": "dataLists",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/dataLists",
        "required": false,
        "description": "Read from src/*/data-lists/4.3.3/"
      },
      {
        "name": "toolkit",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/toolkit",
        "required": false,
        "description": "Read from library/ihris-toolkit/"
      },
      {
        "name": "wikiHelp",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/wikiHelp",
        "required": false,
        "description": "Read from library/ihris-wiki/"
      },
      {
        "name": "handbook",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/handbook",
        "required": false,
        "description": "Read from library/ihris-admin-handbook/"
      },
      {
        "name": "useCases",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/useCases",
        "required": false,
        "description": "Read from library/ihris-use-cases/"
      },
      {
        "name": "ihris5Inventory",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/ihris5Inventory",
        "required": false,
        "description": "Read from src/ihris5/inventory/"
      },
      {
        "name": "dataDictionary",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/dataDictionary",
        "required": false,
        "description": "Read from src/ihris-data-dictionary/data-dictionary/"
      },
      {
        "name": "terminology",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/terminology",
        "required": false,
        "description": "Read from src/ihris-data-dictionary/terminology/"
      },
      {
        "name": "glossary",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/glossary",
        "required": false,
        "description": "Read from glossary/"
      },
      {
        "name": "schemas",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/schemas",
        "required": false,
        "description": "Read from src/schemas/"
      },
      {
        "name": "theme",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/theme",
        "required": false,
        "description": "Read from src/site/theme/"
      }
    ],
    "outputs": [
      {
        "name": "site",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/site",
        "description": "(records: https://www.iana.org/assignments/media-types/text/html)"
      }
    ]
  },
  "satisfies": [
    "build-ihris-site"
  ],
  "requires": {
    "runtime": [
      "python3",
      "bun"
    ],
    "network": false
  },
  "maintains": [
    {
      "source": "src",
      "artefact": "_site",
      "format": "html"
    }
  ]
}
