{
  "id": "ihris-build-kg",
  "title": "Build the iHRIS knowledge graph",
  "description": "Regenerates every derived node from uploads/: Launchpad catalogue (projects, series, releases with MD5s), I2CE modules and form classes from a checksum-verified release tarball, restored wiki pages, toolkit stages, iHRIS 5 catalogue. Deterministic; removes and rewrites its own output directories.",
  "install": {
    "cli": "pip install beautifulsoup4 markdownify"
  },
  "invoke": {
    "shell": "python3 src/tools/build_kg.py"
  },
  "io": {
    "inputs": [
      {
        "name": "launchpadCaptures",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/launchpadCaptures",
        "required": false,
        "description": "Read from uploads/launchpad/"
      },
      {
        "name": "releaseTarball",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/releaseTarball",
        "required": false,
        "description": "Read from uploads/ihris-suite-4.3.3/"
      },
      {
        "name": "toolkitPages",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/toolkitPages",
        "required": false,
        "description": "Read from uploads/toolkit/"
      },
      {
        "name": "githubSnapshot",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/githubSnapshot",
        "required": false,
        "description": "Read from uploads/github/"
      }
    ],
    "outputs": [
      {
        "name": "catalogue-node",
        "schema": "https://litlfred.github.io/folio-assistant/schemas/folio-catalogue-node.schema.json"
      },
      {
        "name": "source-record",
        "schema": "https://github.com/litlfred/ihris/blob/main/src/schemas/ihris-source-record.schema.json"
      },
      {
        "name": "module",
        "schema": "https://github.com/litlfred/ihris/blob/main/src/schemas/ihris-i2ce-module.schema.json"
      },
      {
        "name": "form-class",
        "schema": "https://github.com/litlfred/ihris/blob/main/src/schemas/ihris-form-class.schema.json"
      },
      {
        "name": "toolkit-stage",
        "schema": "https://github.com/litlfred/ihris/blob/main/src/schemas/ihris-toolkit-stage.schema.json"
      },
      {
        "name": "catalogue",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/catalogue",
        "description": "Written to src/*/catalogue/"
      },
      {
        "name": "modules",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/modules",
        "description": "Written to src/*/modules/"
      },
      {
        "name": "dataModel",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/dataModel",
        "description": "Written to src/*/data-model/4.3.3/"
      },
      {
        "name": "dataLists",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/dataLists",
        "description": "Written to src/*/data-lists/4.3.3/"
      },
      {
        "name": "toolkit",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/toolkit",
        "description": "Written to library/ihris-toolkit/"
      },
      {
        "name": "wikiHelp",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/wikiHelp",
        "description": "Written to library/ihris-wiki/"
      },
      {
        "name": "ihris5Inventory",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/ihris5Inventory",
        "description": "Written to src/ihris5/inventory/"
      }
    ]
  },
  "satisfies": [
    "describe-launchpad-source",
    "extract-i2ce-modules",
    "ingest-toolkit-stage",
    "restore-wiki-from-help-export",
    "snapshot-github-repo"
  ],
  "requires": {
    "runtime": [
      "python3>=3.10"
    ],
    "network": false
  }
}
