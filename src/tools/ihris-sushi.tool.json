{
  "id": "ihris-sushi",
  "title": "SUSHI: build the ihris-4-on-fhir FSH",
  "description": "Compiles the FSH in src/ihris-4-on-fhir (generated by build_dak.py and gen_fsh.py) into FHIR R4 resources. Pinned at fsh-sushi 3.20.1 (phase F1). Run by gen_fsh.py, which fails unless SUSHI reports 0 errors and 0 warnings.",
  "install": {
    "cli": "npm install -g fsh-sushi@3.20.1"
  },
  "invoke": {
    "shell": "sushi build src/ihris-4-on-fhir"
  },
  "io": {
    "inputs": [
      {
        "name": "fsh",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/fsh",
        "required": false,
        "description": "Read from src/ihris-4-on-fhir/input/fsh/"
      }
    ],
    "outputs": [
      {
        "name": "fhir-resources",
        "schema": "http://hl7.org/fhir/R4/fhir.schema.json"
      },
      {
        "name": "fhirResources",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/fhirResources",
        "description": "Written to src/ihris-4-on-fhir/fsh-generated/"
      }
    ]
  },
  "satisfies": [
    "ihris-4-on-fhir"
  ],
  "requires": {
    "runtime": [
      "node"
    ],
    "network": true
  }
}
