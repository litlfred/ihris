{
  "id": "ihris-validate-kg",
  "title": "Validate the iHRIS knowledge graph",
  "description": "Checks every ihris-* node against src/schemas/, every folio-catalogue(-node)/v1 file and Tool node against folio-assistant's own zod schemas (from the mounted folio-assistant-core and cat-harness), and that metadataRef, module parent/formClasses and releaseFile references resolve.",
  "install": {
    "cli": "pip install jsonschema; src/tools/mount_platform.sh (mounts folio-assistant-core and its closure from index.lock.json, then bun install)"
  },
  "invoke": {
    "shell": "python3 src/tools/validate.py"
  },
  "io": {
    "inputs": [
      {
        "name": "schemas",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/schemas",
        "required": false,
        "description": "Read from src/schemas/"
      },
      {
        "name": "catalogue",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/catalogue",
        "required": false,
        "description": "Read from src/*/catalogue/"
      },
      {
        "name": "modules",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/modules",
        "required": false,
        "description": "Read from src/*/modules/"
      },
      {
        "name": "dataModel",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/dataModel",
        "required": false,
        "description": "Read from src/*/data-model/4.3.3/"
      },
      {
        "name": "dataLists",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/dataLists",
        "required": false,
        "description": "Read from src/*/data-lists/4.3.3/"
      },
      {
        "name": "toolkit",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/toolkit",
        "required": false,
        "description": "Read from library/ihris-toolkit/"
      },
      {
        "name": "wikiHelp",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/wikiHelp",
        "required": false,
        "description": "Read from library/ihris-wiki/"
      },
      {
        "name": "handbook",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/handbook",
        "required": false,
        "description": "Read from library/ihris-admin-handbook/"
      },
      {
        "name": "useCases",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/useCases",
        "required": false,
        "description": "Read from library/ihris-use-cases/"
      },
      {
        "name": "dataDictionary",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/dataDictionary",
        "required": false,
        "description": "Read from src/ihris-data-dictionary/data-dictionary/"
      },
      {
        "name": "terminology",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/terminology",
        "required": false,
        "description": "Read from src/ihris-data-dictionary/terminology/"
      },
      {
        "name": "glossary",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/glossary",
        "required": false,
        "description": "Read from glossary/"
      },
      {
        "name": "beans",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/beans",
        "required": false,
        "description": "Read from beans/defs/"
      },
      {
        "name": "processes",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/processes",
        "required": false,
        "description": "Read from processes/"
      },
      {
        "name": "processSpecs",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/processSpecs",
        "required": false,
        "description": "Read from processes/specs/"
      }
    ],
    "outputs": [
      {
        "name": "report",
        "schema": "https://www.iana.org/assignments/media-types/text/plain"
      },
      {
        "name": "qaReport",
        "schema": "https://github.com/litlfred/ihris/src/schemas/skills/artefacts.schema.json#/$defs/qaReport",
        "description": "Written to stdout"
      }
    ]
  },
  "satisfies": [
    "describe-launchpad-source",
    "extract-i2ce-modules",
    "ingest-toolkit-stage",
    "restore-wiki-from-help-export",
    "snapshot-github-repo",
    "derive-dak-data-dictionary"
  ],
  "requires": {
    "runtime": [
      "python3",
      "bun"
    ],
    "network": false
  }
}
