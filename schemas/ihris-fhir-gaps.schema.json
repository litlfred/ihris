{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/litlfred/ihris/src/schemas/ihris-fhir-gaps.schema.json",
  "title": "ihris-fhir-gaps/v1",
  "description": "GENERATED by src/tools/map_ihris5.py from the crosswalk: the two-way gap report. iHRIS 4 logical-model elements with no exact or accepted target in any iHRIS 5 IG; and per IG, iHRIS 5 profile elements and extensions no iHRIS 4 element maps to. Its Markdown twin is gaps.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "_comment",
    "crosswalk",
    "counts",
    "ihris4",
    "ihris5"
  ],
  "properties": {
    "$schema": {
      "const": "ihris-fhir-gaps/v1"
    },
    "_comment": {
      "type": "string"
    },
    "crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ihris4ElementsWithNoTarget",
        "ihris5"
      ],
      "properties": {
        "ihris4ElementsWithNoTarget": {
          "type": "integer"
        },
        "ihris5": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "ig",
              "manage",
              "qualify"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profileElements",
              "extensions"
            ],
            "properties": {
              "profileElements": {
                "type": "integer"
              },
              "extensions": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "ihris4": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "element",
          "label",
          "byIg"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "element": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "byIg": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "ig",
                "manage",
                "qualify"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "ihris5": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "ig",
          "manage",
          "qualify"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileElements",
          "extensions"
        ],
        "properties": {
          "profileElements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "path",
                "label",
                "candidateOnly"
              ],
              "properties": {
                "profile": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "candidateOnly": {
                  "type": "boolean"
                }
              }
            }
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "extension",
                "url",
                "title"
              ],
              "properties": {
                "extension": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
